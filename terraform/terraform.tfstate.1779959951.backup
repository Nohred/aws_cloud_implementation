    {
      "module": "module.monitoring",
      "mode": "managed",
      "type": "aws_cloudwatch_dashboard",
      "name": "main",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "dashboard_arn": "arn:aws:cloudwatch::979054355848:dashboard/waste-classifier-dev-monitoring-dashboard",
            "dashboard_body": "{\"widgets\":[{\"height\":6,\"properties\":{\"metrics\":[[{\"expression\":\"SEARCH('Namespace=\\\"Glue\\\" MetricName=\\\"glue.driver.aggregate.elapsedTime\\\" JobName=\\\"waste-classifier-dev-image-resize\\\"', 'Average', 300)\",\"id\":\"e1\",\"label\":\"Elapsed Time (ms)\"}]],\"period\":300,\"region\":\"us-east-1\",\"stacked\":false,\"stat\":\"Average\",\"title\":\"Widget 1: Duración de Glue Job (Image Resize)\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"label\":\"Milisegundos\",\"min\":0}}},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":0},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/S3\",\"NumberOfObjects\",\"StorageType\",\"AllStorageTypes\",\"BucketName\",\"waste-classifier-dev-processed-v3\"]],\"period\":86400,\"region\":\"us-east-1\",\"stat\":\"Maximum\",\"title\":\"Widget 2: Archivos en Curated Zone (Processed v3) — rango mínimo: 1d\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":0},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/SageMaker\",\"Invocations\",\"EndpointName\",\"waste-classifier-dev-classifier-endpoint\",\"VariantName\",\"AllTraffic\",{\"color\":\"#2ca02c\",\"label\":\"Invocaciones totales\"}],[\"AWS/SageMaker\",\"Invocation4XXErrors\",\"EndpointName\",\"waste-classifier-dev-classifier-endpoint\",\"VariantName\",\"AllTraffic\",{\"color\":\"#ff7f0e\",\"label\":\"Errores 4XX (cliente)\"}],[\"AWS/SageMaker\",\"Invocation5XXErrors\",\"EndpointName\",\"waste-classifier-dev-classifier-endpoint\",\"VariantName\",\"AllTraffic\",{\"color\":\"#d62728\",\"label\":\"Errores 5XX (modelo)\"}]],\"period\":60,\"region\":\"us-east-1\",\"stacked\":false,\"stat\":\"Sum\",\"title\":\"Widget 3: Errores en SageMaker Endpoint (4XX y 5XX)\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":6},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/SageMaker\",\"ModelLatency\",\"EndpointName\",\"waste-classifier-dev-classifier-endpoint\",\"VariantName\",\"AllTraffic\",{\"color\":\"#9467bd\",\"label\":\"Latencia del Modelo (µs)\"}],[\"AWS/SageMaker\",\"OverheadLatency\",\"EndpointName\",\"waste-classifier-dev-classifier-endpoint\",\"VariantName\",\"AllTraffic\",{\"color\":\"#bcbd22\",\"label\":\"Overhead SageMaker (µs)\"}]],\"period\":60,\"region\":\"us-east-1\",\"stacked\":false,\"stat\":\"Average\",\"title\":\"Tiempo Real de Inferencia (Model Latency)\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"label\":\"Microsegundos (µs)\",\"min\":0}}},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":6},{\"height\":6,\"properties\":{\"metrics\":[[\"WasteClassifier/Metrics\",\"InferenceSuccess\",{\"color\":\"#2ca02c\",\"label\":\"Éxito\"}],[\"WasteClassifier/Metrics\",\"InferenceFailure\",{\"color\":\"#d62728\",\"label\":\"Fallo\"}]],\"period\":300,\"region\":\"us-east-1\",\"stacked\":false,\"stat\":\"Sum\",\"title\":\"Imágenes procesadas con éxito vs fallidas\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":12},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/S3\",\"BucketSizeBytes\",\"StorageType\",\"StandardStorage\",\"BucketName\",\"waste-classifier-dev-processed-v3\",{\"id\":\"m1\",\"visible\":false}],[\"AWS/S3\",\"NumberOfObjects\",\"StorageType\",\"AllStorageTypes\",\"BucketName\",\"waste-classifier-dev-processed-v3\",{\"id\":\"m2\",\"visible\":false}],[{\"expression\":\"m1/m2\",\"id\":\"e1\",\"label\":\"Promedio Bytes por Archivo\",\"region\":\"us-east-1\"}]],\"period\":86400,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Tamaño Promedio de Archivos en Processed (Bytes) — rango mínimo: 1d\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":12},{\"height\":6,\"properties\":{\"metrics\":[[{\"expression\":\"SEARCH('{/aws/sagemaker/TrainingJobs,TrainingJobName} MetricName=\\\"train:loss\\\" TrainingJobName=~\\\"waste-classifier-*\\\"', 'Average', 60)\",\"id\":\"e1\",\"label\":\"train:loss\"}],[{\"expression\":\"SEARCH('{/aws/sagemaker/TrainingJobs,TrainingJobName} MetricName=\\\"val:loss\\\" TrainingJobName=~\\\"waste-classifier-*\\\"', 'Average', 60)\",\"id\":\"e2\",\"label\":\"val:loss\"}]],\"period\":60,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Pérdida / Loss (Train vs Validation)\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":18},{\"height\":6,\"properties\":{\"metrics\":[[{\"expression\":\"SEARCH('{/aws/sagemaker/TrainingJobs,TrainingJobName} MetricName=\\\"train:accuracy\\\" TrainingJobName=~\\\"waste-classifier-*\\\"', 'Average', 60)\",\"id\":\"e3\",\"label\":\"train:accuracy\"}],[{\"expression\":\"SEARCH('{/aws/sagemaker/TrainingJobs,TrainingJobName} MetricName=\\\"val:accuracy\\\" TrainingJobName=~\\\"waste-classifier-*\\\"', 'Average', 60)\",\"id\":\"e4\",\"label\":\"val:accuracy\"}]],\"period\":60,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Exactitud / Accuracy (Train vs Validation)\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":18},{\"height\":6,\"properties\":{\"metrics\":[[{\"expression\":\"SEARCH('{/aws/sagemaker/TrainingJobs,TrainingJobName} MetricName=\\\"train:macro_f1\\\" TrainingJobName=~\\\"waste-classifier-*\\\"', 'Average', 60)\",\"id\":\"e5\",\"label\":\"train:macro_f1\"}],[{\"expression\":\"SEARCH('{/aws/sagemaker/TrainingJobs,TrainingJobName} MetricName=\\\"val:macro_f1\\\" TrainingJobName=~\\\"waste-classifier-*\\\"', 'Average', 60)\",\"id\":\"e6\",\"label\":\"val:macro_f1\"}]],\"period\":60,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Macro F1 Score (Train vs Validation)\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":24},{\"height\":6,\"properties\":{\"metrics\":[[{\"expression\":\"SEARCH('{/aws/sagemaker/TrainingJobs,TrainingJobName} MetricName=\\\"train:recall\\\" TrainingJobName=~\\\"waste-classifier-*\\\"', 'Average', 60)\",\"id\":\"e7\",\"label\":\"train:recall\"}],[{\"expression\":\"SEARCH('{/aws/sagemaker/TrainingJobs,TrainingJobName} MetricName=\\\"val:recall\\\" TrainingJobName=~\\\"waste-classifier-*\\\"', 'Average', 60)\",\"id\":\"e8\",\"label\":\"val:recall\"}]],\"period\":60,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Sensibilidad / Recall (Train vs Validation)\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":24},{\"height\":6,\"properties\":{\"query\":\"SOURCE '/aws/sagemaker/TrainingJobs' | filter @message like /\\\"Conjunto\\\"/ | display Conjunto, Accuracy, MacroF1, Recall | sort @timestamp desc | limit 3\",\"region\":\"us-east-1\",\"title\":\"Resumen de Evaluación Final (Último Entrenamiento)\",\"view\":\"table\"},\"type\":\"log\",\"width\":24,\"x\":0,\"y\":30}]}",
            "dashboard_name": "waste-classifier-dev-monitoring-dashboard",
