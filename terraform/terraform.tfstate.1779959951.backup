        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:us-east-1:979054355848:stateMachine:waste-classifier-dev-etl-orchestration",
            "creation_date": "2026-05-28T04:17:09Z",
            "definition": "{\"Comment\":\"Run Glue crawler, wait for catalog refresh, then run the Glue job and trigger SageMaker training\",\"StartAt\":\"StartCrawler\",\"States\":{\"CrawlerFailed\":{\"Cause\":\"Glue crawler did not succeed\",\"Error\":\"CrawlerFailed\",\"Type\":\"Fail\"},\"CrawlerFinished\":{\"Choices\":[{\"Next\":\"StartGlueJob\",\"StringEquals\":\"READY\",\"Variable\":\"$.CrawlerStatus.Crawler.State\"}],\"Default\":\"CrawlerFailed\",\"Type\":\"Choice\"},\"CrawlerRunning\":{\"Choices\":[{\"Next\":\"WaitForCrawler\",\"StringEquals\":\"RUNNING\",\"Variable\":\"$.CrawlerStatus.Crawler.State\"},{\"Next\":\"WaitForCrawler\",\"StringEquals\":\"STOPPING\",\"Variable\":\"$.CrawlerStatus.Crawler.State\"}],\"Default\":\"CrawlerFinished\",\"Type\":\"Choice\"},\"CreateEndpointConfig\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"JobFailed\",\"ResultPath\":\"$.EndpointConfigError\"}],\"Next\":\"UpdateEndpoint\",\"Parameters\":{\"EndpointConfigName.$\":\"States.Format('waste-classifier-b3-{}', $$.Execution.Name)\",\"ProductionVariants\":[{\"InitialInstanceCount\":1,\"InstanceType\":\"ml.m5.large\",\"ModelName.$\":\"States.Format('waste-classifier-b3-{}', $$.Execution.Name)\",\"VariantName\":\"AllTraffic\"}]},\"Resource\":\"arn:aws:states:::sagemaker:createEndpointConfig\",\"ResultPath\":\"$.EndpointConfigResult\",\"Type\":\"Task\"},\"CreateModel\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"JobFailed\",\"ResultPath\":\"$.CreateModelError\"}],\"Next\":\"CreateEndpointConfig\",\"Parameters\":{\"ExecutionRoleArn\":\"arn:aws:iam::979054355848:role/waste-classifier-dev-sagemaker-execution-role\",\"ModelName.$\":\"States.Format('waste-classifier-b3-{}', $$.Execution.Name)\",\"PrimaryContainer\":{\"Image\":\"763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-inference:2.0.1-gpu-py310-cu118-ubuntu20.04-sagemaker\",\"ModelDataUrl.$\":\"States.Format('s3://waste-classifier-dev-code-v3/models/waste-classifier-b3-{}/output/model.tar.gz', $$.Execution.Name)\"}},\"Resource\":\"arn:aws:states:::sagemaker:createModel\",\"ResultPath\":\"$.CreateModelResult\",\"Type\":\"Task\"},\"EndpointUpdating\":{\"Choices\":[{\"Next\":\"WaitForEndpointUpdate\",\"StringEquals\":\"UPDATING\",\"Variable\":\"$.EndpointStatus.EndpointStatus\"},{\"Next\":\"PipelineSucceeded\",\"StringEquals\":\"IN_SERVICE\",\"Variable\":\"$.EndpointStatus.EndpointStatus\"}],\"Default\":\"JobFailed\",\"Type\":\"Choice\"},\"GetCrawlerStatus\":{\"Next\":\"CrawlerRunning\",\"Parameters\":{\"Name\":\"waste-classifier-dev-raw-crawler\"},\"Resource\":\"arn:aws:states:::aws-sdk:glue:getCrawler\",\"ResultPath\":\"$.CrawlerStatus\",\"Type\":\"Task\"},\"GetEndpointStatus\":{\"Next\":\"EndpointUpdating\",\"Parameters\":{\"EndpointName\":\"waste-classifier-dev-classifier-endpoint\"},\"Resource\":\"arn:aws:states:::aws-sdk:sagemaker:describeEndpoint\",\"ResultPath\":\"$.EndpointStatus\",\"Type\":\"Task\"},\"GetJobStatus\":{\"Next\":\"JobRunning\",\"Parameters\":{\"JobName\":\"waste-classifier-dev-image-resize\",\"RunId.$\":\"$.JobStart.JobRunId\"},\"Resource\":\"arn:aws:states:::aws-sdk:glue:getJobRun\",\"ResultPath\":\"$.JobStatus\",\"Type\":\"Task\"},\"JobEvaluation\":{\"Choices\":[{\"Next\":\"StartSageMakerTraining\",\"StringEquals\":\"SUCCEEDED\",\"Variable\":\"$.JobStatus.JobRun.JobRunState\"}],\"Default\":\"JobFailed\",\"Type\":\"Choice\"},\"JobFailed\":{\"Cause\":\"Glue job or SageMaker training did not succeed\",\"Error\":\"JobFailed\",\"Type\":\"Fail\"},\"JobRunning\":{\"Choices\":[{\"Next\":\"WaitForJob\",\"StringEquals\":\"RUNNING\",\"Variable\":\"$.JobStatus.JobRun.JobRunState\"}],\"Default\":\"JobEvaluation\",\"Type\":\"Choice\"},\"PipelineSucceeded\":{\"Type\":\"Succeed\"},\"StartCrawler\":{\"Next\":\"WaitForCrawler\",\"Parameters\":{\"Name\":\"waste-classifier-dev-raw-crawler\"},\"Resource\":\"arn:aws:states:::aws-sdk:glue:startCrawler\",\"ResultPath\":\"$.CrawlerStart\",\"Type\":\"Task\"},\"StartGlueJob\":{\"Next\":\"WaitForJob\",\"Parameters\":{\"Arguments\":{\"--target_batch.$\":\"$$.Execution.Input.target_batch\"},\"JobName\":\"waste-classifier-dev-image-resize\"},\"Resource\":\"arn:aws:states:::aws-sdk:glue:startJobRun\",\"ResultPath\":\"$.JobStart\",\"Type\":\"Task\"},\"StartSageMakerTraining\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"JobFailed\",\"ResultPath\":\"$.SageMakerError\"}],\"Next\":\"CreateModel\",\"Parameters\":{\"AlgorithmSpecification\":{\"MetricDefinitions\":[{\"Name\":\"train:loss\",\"Regex\":\"train:loss=([0-9\\\\.]+);\"},{\"Name\":\"train:accuracy\",\"Regex\":\"train:accuracy=([0-9\\\\.]+);\"},{\"Name\":\"train:macro_f1\",\"Regex\":\"train:macro_f1=([0-9\\\\.]+);\"},{\"Name\":\"train:recall\",\"Regex\":\"train:recall=([0-9\\\\.]+);\"},{\"Name\":\"val:loss\",\"Regex\":\"val:loss=([0-9\\\\.]+);\"},{\"Name\":\"val:accuracy\",\"Regex\":\"val:accuracy=([0-9\\\\.]+);\"},{\"Name\":\"val:macro_f1\",\"Regex\":\"val:macro_f1=([0-9\\\\.]+);\"},{\"Name\":\"val:recall\",\"Regex\":\"val:recall=([0-9\\\\.]+);\"}],\"TrainingImage\":\"763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-training:2.0.1-gpu-py310-cu118-ubuntu20.04-sagemaker\",\"TrainingInputMode\":\"File\"},\"Environment\":{\"INFERENCE_SCRIPT_BUCKET\":\"waste-classifier-dev-code-v3\",\"INFERENCE_SCRIPT_KEY\":\"inference/inference.py\",\"MODEL_SSM_PARAMETER\":\"/waste-classifier/dev/latest-model-url\",\"SM_HP_S3_OUTPUT_PATH\":\"s3://waste-classifier-dev-code-v3/models\",\"SSM_PREFIX\":\"/waste-classifier/dev\",\"TRAINING_JOB_NAME.$\":\"States.Format('waste-classifier-b3-{}', $$.Execution.Name)\"},\"HyperParameters\":{\"batch_size\":\"32\",\"epochs\":\"25\",\"lr\":\"0.0005\",\"num_classes\":\"10\",\"sagemaker_program\":\"train.py\",\"sagemaker_submit_directory\":\"s3://waste-classifier-dev-code-v3/training/sourcedir.tar.gz\"},\"InputDataConfig\":[{\"ChannelName\":\"train\",\"ContentType\":\"application/x-recordio\",\"DataSource\":{\"S3DataSource\":{\"S3DataDistributionType\":\"FullyReplicated\",\"S3DataType\":\"S3Prefix\",\"S3Uri.$\":\"States.Format('s3://waste-classifier-dev-processed-v3/{}/', $$.Execution.Input.target_batch)\"}}},{\"ChannelName\":\"validation\",\"ContentType\":\"application/x-recordio\",\"DataSource\":{\"S3DataSource\":{\"S3DataDistributionType\":\"FullyReplicated\",\"S3DataType\":\"S3Prefix\",\"S3Uri.$\":\"States.Format('s3://waste-classifier-dev-processed-v3/{}/', $$.Execution.Input.target_batch)\"}}},{\"ChannelName\":\"test\",\"ContentType\":\"application/x-recordio\",\"DataSource\":{\"S3DataSource\":{\"S3DataDistributionType\":\"FullyReplicated\",\"S3DataType\":\"S3Prefix\",\"S3Uri.$\":\"States.Format('s3://waste-classifier-dev-processed-v3/{}/', $$.Execution.Input.target_batch)\"}}}],\"OutputDataConfig\":{\"S3OutputPath\":\"s3://waste-classifier-dev-code-v3/models/\"},\"ResourceConfig\":{\"InstanceCount\":1,\"InstanceType\":\"ml.g4dn.xlarge\",\"VolumeSizeInGB\":30},\"RoleArn\":\"arn:aws:iam::979054355848:role/waste-classifier-dev-sagemaker-execution-role\",\"StoppingCondition\":{\"MaxRuntimeInSeconds\":18000},\"TensorBoardOutputConfig\":{\"S3OutputPath\":\"s3://waste-classifier-dev-code-v3/tensorboard/\"},\"TrainingJobName.$\":\"States.Format('waste-classifier-b3-{}', $$.Execution.Name)\"},\"Resource\":\"arn:aws:states:::sagemaker:createTrainingJob.sync\",\"ResultPath\":\"$.SageMakerResult\",\"Type\":\"Task\"},\"UpdateEndpoint\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"JobFailed\",\"ResultPath\":\"$.UpdateEndpointError\"}],\"Next\":\"WaitForEndpointUpdate\",\"Parameters\":{\"EndpointConfigName.$\":\"States.Format('waste-classifier-b3-{}', $$.Execution.Name)\",\"EndpointName\":\"waste-classifier-dev-classifier-endpoint\"},\"Resource\":\"arn:aws:states:::sagemaker:updateEndpoint\",\"ResultPath\":\"$.UpdateEndpointResult\",\"Type\":\"Task\"},\"WaitForCrawler\":{\"Next\":\"GetCrawlerStatus\",\"Seconds\":30,\"Type\":\"Wait\"},\"WaitForEndpointUpdate\":{\"Next\":\"GetEndpointStatus\",\"Seconds\":60,\"Type\":\"Wait\"},\"WaitForJob\":{\"Next\":\"GetJobStatus\",\"Seconds\":60,\"Type\":\"Wait\"}}}",
